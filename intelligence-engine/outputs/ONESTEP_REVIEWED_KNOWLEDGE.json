  "rules": [
    {
      "id": "AU-GS-REVIEWED-2026-10-02",
      "module": "visa",
      "jurisdiction": "AU",
      "applicant_scope": "student_visa_primary",
      "title": "Subclass 500 Genuine Student requirement",
      "rule_type": "genuine_student_assessment",
      "payload": {
        "assessment_factors": [
          "current circumstances",
          "course choice rationale",
          "provider choice rationale",
          "value of course to applicant future",
          "immigration history",
          "intention to comply with visa conditions"
        ],
        "replaced_prior_rule": "Genuine Temporary Entrant"
      },
      "effective_from": "2024-03-23",
      "effective_to": null,
      "source_id": "au-home-affairs-student-500-gs",
      "source_url": "https://immi.homeaffairs.gov.au/visas/getting-a-visa/visa-listing/student-500/genuine-student-requirement",
      "last_verified": "2026-10-02",
      "confidence": 0.95,
      "status": "active",
      "created_at": "2026-10-02 02:33:28",
      "updated_at": "2026-10-02 02:33:28",
      "rule_key": "AU:student_visa_primary:visa:genuine_student_assessment",
      "evidence_id": "42ab32b4-3a43-4c8b-95cb-214a24d4ea43",
      "effective_date_basis": "authority_effective_date",
      "reviewed_by": "seed-editor",
      "reviewed_at": "2026-10-02T02:33:28.731393+00:00",
      "authority": "Australian Department of Home Affairs",
      "reliability_tier": 1,
      "evidence_summary": "Home Affairs applies Genuine Student to student visa applications lodged from 23 March 2024; earlier applications use GTE. Responses cover personal circumstances, course and provider selection, future benefits and other relevant information, supported by evidence. Each response is limited to 150 English words.",
      "evidence_method": "official_page_reviewed_summary"
    },
    {
      "id": "CA-WORK-OBSERVED-2026-10-02",
      "module": "work_rights",
      "jurisdiction": "CA",
      "applicant_scope": "study_permit_primary",
      "title": "Off-campus work limit for eligible study permit holders",
      "rule_type": "student_work_hours",
      "payload": {
        "limit": "24 hours per week during regular academic terms",
        "program_requirement": "Program must generally be at least 6 months and lead to a degree, diploma or certificate",
        "remote_foreign_employer": "Remote work for an employer outside Canada does not count toward the 24-hour off-campus limit",
        "scheduled_breaks": "Unlimited hours during scheduled breaks if eligibility requirements continue to be met"
      },
      "effective_from": "2026-10-02",
      "effective_to": null,
      "source_id": "ca-ircc-work-off-campus",
      "source_url": "https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/work-off-campus.html",
      "last_verified": "2026-10-02",
      "confidence": 0.95,
      "status": "active",
      "created_at": "2026-10-02 02:33:28",
      "updated_at": "2026-10-02 02:33:28",
      "rule_key": "CA:study_permit_primary:work_rights:student_work_hours",
      "evidence_id": "be3966a2-80ff-494f-98b5-787be1c291e2",
      "effective_date_basis": "observed_from",
      "reviewed_by": "seed-editor",
      "reviewed_at": "2026-10-02T02:33:28.733313+00:00",
      "authority": "Immigration, Refugees and Citizenship Canada",
      "reliability_tier": 1,
      "evidence_summary": "Eligible study permit holders may work off campus for up to 24 hours weekly during regular academic sessions. Scheduled breaks permit unrestricted hours only while all eligibility criteria remain satisfied. A qualifying program normally lasts at least six months and leads to a degree, diploma or certificate. Foreign-employer remote work is treated separately.",
      "evidence_method": "official_page_reviewed_summary"
    },
    {
      "id": "DE-WORK-OBSERVED-2026-10-02",
      "module": "work_rights",
      "jurisdiction": "DE",
      "applicant_scope": "student_residence_permit_primary",
      "title": "Third-country student work allowance",
      "rule_type": "student_work_hours",
      "payload": {
        "alternative": "Up to 20 hours weekly in the lecture period; unrestricted work during semester breaks under the stated alternative",
        "full_days_per_year": 140,
        "half_day_max_hours": 4,
        "half_days_per_year": 280,
        "self_employment": "Requires approval by the competent foreigners authority",
        "student_auxiliary_tasks": "Restrictions do not apply to academic student auxiliary tasks"
      },
      "effective_from": "2026-10-02",
      "effective_to": null,
      "source_id": "de-make-it-in-germany-study-work",
